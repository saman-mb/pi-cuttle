# LangFuse Environment Variables
# Copy this file to .env and fill in the values.
# DO NOT commit real secrets to version control.

# ---------------------------------------------------------------------------
# Database Configuration (PostgreSQL)
# ---------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres

# ---------------------------------------------------------------------------
# ClickHouse Configuration
# ---------------------------------------------------------------------------
CLICKHOUSE_USER=clickhouse
CLICKHOUSE_PASSWORD=clickhouse

# ---------------------------------------------------------------------------
# Redis Configuration (required by LangFuse v3+)
# ---------------------------------------------------------------------------
REDIS_AUTH=change-me-to-a-secure-redis-password

# ---------------------------------------------------------------------------
# MinIO / S3 Configuration
# ---------------------------------------------------------------------------
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=miniosecret
LANGFUSE_S3_BUCKET=langfuse

# ---------------------------------------------------------------------------
# Application Port
# ---------------------------------------------------------------------------
LANGFUSE_PORT=3000

# ---------------------------------------------------------------------------
# Authentication & Security (REQUIRED - generate secure random strings)
# ---------------------------------------------------------------------------
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=change-me-to-a-secure-random-string

# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=change-me-to-a-secure-random-string

# Generate with: openssl rand -base64 16
SALT=change-me-to-a-secure-random-string

# ---------------------------------------------------------------------------
# Auto-provisioned API keys (used by pi-cuttle)
# ---------------------------------------------------------------------------
# Generate with: openssl rand -hex 32  (or any strong secret)
LANGFUSE_PUBLIC_KEY=pk-pi-cuttle-change-me
LANGFUSE_SECRET_KEY=sk-pi-cuttle-change-me

# Initial admin user (change before exposing to a network)
LANGFUSE_INIT_USER_EMAIL=admin@example.com
LANGFUSE_INIT_USER_NAME=admin
LANGFUSE_INIT_USER_PASSWORD=password

# ---------------------------------------------------------------------------
# Feature Flags
# ---------------------------------------------------------------------------
LANGFUSE_ENABLE_EXPERIMENTAL_FEATURES=false
