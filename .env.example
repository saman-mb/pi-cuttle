# LangFuse Environment Variables
# Copy this file to .env and fill in the values
# DO NOT commit real secrets to version control

# ---------------------------------------------------------------------------
# Database Configuration (PostgreSQL)
# ---------------------------------------------------------------------------
LANGFUSE_DATABASE_USER=postgres
LANGFUSE_DATABASE_PASSWORD=postgres
LANGFUSE_DATABASE_NAME=langfuse

# ---------------------------------------------------------------------------
# Application Port
# ---------------------------------------------------------------------------
LANGFUSE_PORT=3000

# ---------------------------------------------------------------------------
# Authentication & Security (REQUIRED - generate secure random strings)
# ---------------------------------------------------------------------------
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=change-me-to-a-secure-random-string

# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=change-me-to-a-secure-random-string

# Generate with: openssl rand -base64 16
SALT=change-me-to-a-secure-random-string

# ---------------------------------------------------------------------------
# Redis Configuration (Optional - improves performance)
# To enable Redis, start docker compose with --profile redis
# ---------------------------------------------------------------------------
REDIS_HOST=langfuse-redis
REDIS_PORT=6379
REDIS_AUTH=

# ---------------------------------------------------------------------------
# Feature Flags
# ---------------------------------------------------------------------------
LANGFUSE_ENABLE_EXPERIMENTAL_FEATURES=false
