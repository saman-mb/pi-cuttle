{
  "name": "pi-cuttle",
  "version": "0.3.1",
  "description": "Local-first model routing for pi — a local classifier picks the right model per turn, with a cross-process memory governor so subagent fanout cannot exhaust local VRAM. The pi extension for Cuttle.",
  "type": "module",
  "license": "MIT",
  "author": "Saman Mathew Badakhshan",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/saman-mb/pi-cuttle.git"
  },
  "homepage": "https://github.com/saman-mb/pi-cuttle#readme",
  "bugs": {
    "url": "https://github.com/saman-mb/pi-cuttle/issues"
  },
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "extension",
    "cuttle",
    "model-routing",
    "model-router",
    "llm-router",
    "local-first",
    "hybrid",
    "classifier",
    "decision-model",
    "system-one",
    "jev",
    "local-llm",
    "lm-studio",
    "ollama",
    "llama-cpp",
    "vllm",
    "openai-compatible",
    "memory-governor",
    "vram",
    "subagents",
    "cost-optimization"
  ],
  "pi": {
    "image": "https://raw.githubusercontent.com/saman-mb/cuttle/main/docs/assets/logo.png",
    "extensions": [
      "./src/index.ts"
    ]
  },
  "files": [
    "src",
    "docs",
    "eval",
    "examples",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "eval": "node --experimental-strip-types eval/run.ts",
    "typecheck": "tsc --noEmit",
    "badges": "bash scripts/render-badges.sh",
    "lint": "tsc --noEmit",
    "prepublishOnly": "npm test && npm run typecheck"
  },
  "engines": {
    "node": ">=22.6.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-agent-core": {
      "optional": true
    },
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.2.0",
    "@earendil-works/pi-coding-agent": "1.2.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
